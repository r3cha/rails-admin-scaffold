<%# Template: Table Partial for Resource Listing
#
# Variables to replace:
#   {namespace} - Lowercase namespace (e.g., admin)
#   {MODEL} - Model class name (e.g., User)
#   {model} - Lowercase singular (e.g., user)
#   {models} - Lowercase plural (e.g., users)
#   {TABLE_COLUMNS} - Array of columns to display [{name: "email", type: "string"}, ...]
#   {HAS_SOFT_DELETE} - true/false
#
# Replace all CSS classes below with appropriate classes for the detected framework.
# Class names shown are semantic hints only.
%>

<div class="table-responsive">
  <table class="table">
    <thead class="table-header">
      <tr>
        <%# Bulk Selection Checkbox %>
        <th class="th th-checkbox">
          <input type="checkbox"
                 id="select-all"
                 class="checkbox"
                 data-bulk-select-target="selectAll"
                 data-action="change->bulk-select#toggleAll">
        </th>

        <%# ID Column %>
        <th class="th">
          <%%= sort_link(@q, :id, "ID", default_order: :desc) %>
        </th>

        <%#
        # TABLE COLUMN HEADERS:
        # Replace with actual columns from model analysis.
        # Use sort_link for sortable columns.
        %>

        <%# String/Text Column %>
        <%# <th class="th">
          <%%= sort_link(@q, :name, "Name") %>
        </th> %>

        <%# Boolean Column %>
        <%# <th class="th">
          <%%= sort_link(@q, :active, "Active") %>
        </th> %>

        <%# Enum Column %>
        <%# <th class="th">
          <%%= sort_link(@q, :status, "Status") %>
        </th> %>

        <%# Belongs To Column %>
        <%# <th class="th">Author</th> %>

        <%# Timestamps %>
        <th class="th">
          <%%= sort_link(@q, :created_at, "Created", default_order: :desc) %>
        </th>

        <%# Soft Delete Column %>
        <% if {HAS_SOFT_DELETE} && params[:show_deleted] == "1" %>
          <th class="th">Deleted At</th>
        <% end %>

        <%# Actions Column %>
        <th class="th th-actions">Actions</th>
      </tr>
    </thead>

    <tbody class="table-body">
      <%% {models}.each do |{model}| %>
        <tr class="tr <%%= {model}.respond_to?(:discarded?) && {model}.discarded? ? 'tr-deleted' : '' %>">
          <%# Bulk Selection Checkbox %>
          <td class="td">
            <input type="checkbox"
                   class="checkbox row-checkbox"
                   value="<%%= {model}.id %>"
                   data-bulk-select-target="checkbox"
                   data-action="change->bulk-select#toggle">
          </td>

          <%# ID %>
          <td class="td">
            <%%= link_to {model}.id, {namespace}_{model}_path({model}), class: "link" %>
          </td>

          <%#
          # TABLE CELL VALUES:
          # Replace with actual columns from model analysis.
          # See reference/field-mappings.md for display patterns.
          %>

          <%# String Column (with truncation) %>
          <%# <td class="td">
            <%%= truncate({model}.name, length: 50) %>
          </td> %>

          <%# Email Column (with link) %>
          <%# <td class="td">
            <%%= mail_to {model}.email, {model}.email, class: "link" %>
          </td> %>

          <%# Boolean Column (badge) %>
          <%# <td class="td">
            <span class="badge <%%= {model}.active? ? 'badge-success' : 'badge-secondary' %>">
              <%%= {model}.active? ? 'Yes' : 'No' %>
            </span>
          </td> %>

          <%# Enum Column (colored badge) %>
          <%# <td class="td">
            <span class="badge badge-<%%= {model}.status %>">
              <%%= {model}.status.humanize %>
            </span>
          </td> %>

          <%# Belongs To Column %>
          <%# <td class="td">
            <% if {model}.author %>
              <%%= link_to {model}.author.name, {namespace}_user_path({model}.author), class: "link" %>
            <% else %>
              <span class="text-muted">-</span>
            <% end %>
          </td> %>

          <%# Attachment Column (thumbnail) %>
          <%# <td class="td">
            <% if {model}.avatar.attached? && {model}.avatar.image? %>
              <%%= image_tag {model}.avatar.variant(resize_to_limit: [40, 40]), class: "img-thumbnail-sm" %>
            <% elsif {model}.avatar.attached? %>
              <%%= link_to "File", rails_blob_path({model}.avatar), class: "link" %>
            <% else %>
              <span class="text-muted">-</span>
            <% end %>
          </td> %>

          <%# Created At %>
          <td class="td text-muted">
            <%%= {model}.created_at&.strftime("%Y-%m-%d %H:%M") %>
          </td>

          <%# Deleted At (for soft delete) %>
          <% if {HAS_SOFT_DELETE} && params[:show_deleted] == "1" %>
            <td class="td text-danger">
              <%%= {model}.respond_to?(:discarded_at) ? {model}.discarded_at&.strftime("%Y-%m-%d %H:%M") : '-' %>
            </td>
          <% end %>

          <%# Action Buttons %>
          <td class="td td-actions">
            <div class="btn-group">
              <%%= link_to "View", {namespace}_{model}_path({model}), class: "btn-sm btn-outline" %>
              <%%= link_to "Edit", edit_{namespace}_{model}_path({model}), class: "btn-sm btn-outline" %>

              <% if {HAS_SOFT_DELETE} && {model}.respond_to?(:discarded?) && {model}.discarded? %>
                <%%= button_to "Restore",
                              restore_{namespace}_{model}_path({model}),
                              method: :patch,
                              class: "btn-sm btn-success",
                              form_class: "inline-form" %>
              <% else %>
                <%%= button_to "Delete",
                              {namespace}_{model}_path({model}),
                              method: :delete,
                              class: "btn-sm btn-danger",
                              form_class: "inline-form",
                              data: { turbo_confirm: "Are you sure?" } %>
              <% end %>
            </div>
          </td>
        </tr>
      <%% end %>
    </tbody>
  </table>
</div>
