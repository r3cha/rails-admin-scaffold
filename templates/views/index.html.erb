<%# Template: Index View for Resource Listing
#
# Variables to replace:
#   {namespace} - Lowercase namespace (e.g., admin)
#   {MODEL} - Model class name (e.g., User)
#   {model} - Lowercase singular (e.g., user)
#   {models} - Lowercase plural (e.g., users)
#   {MODEL_TITLE} - Human readable title (e.g., "Users", "Blog Posts")
#   {TABLE_COLUMNS} - Array of columns to display
#   {HAS_SOFT_DELETE} - true/false for soft delete support
#
# Replace all CSS classes below with appropriate classes for the detected framework.
# Class names shown (e.g., page-header, card, btn-primary) are semantic hints only.
#
# LAYOUT: Page header (title + count) at top, then filter card, then table card.
# Export CSV and New buttons go in the TABLE CARD HEADER (right side), NOT in the page header.
# Bulk actions (delete selected) appear in the table card header left side when rows are selected.
%>

<%# Page Header — title and record count only, NO action buttons here %>
<div class="page-header">
  <h1 class="page-title">{MODEL_TITLE}</h1>
  <div class="text-muted">{MODEL_TITLE} count info</div>
</div>

<%# Filters %>
<div class="card mb-4">
  <div class="card-body">
    <%%= render "{namespace}/{models}/filters", q: @q %>
  </div>
</div>

<%# Data Table — Export CSV and New buttons go HERE in card-header right side %>
<div class="card">
  <div class="card-header">
    <div class="card-title">
      <%# Bulk actions: hidden by default, shown when checkboxes selected %>
      <div id="bulk-actions-bar" class="hidden flex-center">
        <span><strong id="selected-count">0</strong> selected</span>
        <%%= button_to "Delete Selected",
                      bulk_destroy_{namespace}_{models}_path,
                      method: :delete,
                      params: { ids: [] },
                      class: "btn-danger btn-sm",
                      form: { data: { turbo_confirm: "Are you sure?" } },
                      id: "bulk-delete-btn" %>
      </div>
    </div>
    <div class="card-actions btn-group">
      <%# Export and New buttons — always in table card header right side %>
      <%%= link_to "Export CSV",
                  {namespace}_{models}_path(format: :csv, q: params[:q]&.to_unsafe_h),
                  class: "btn-outline btn-sm" %>
      <%%= link_to "New {MODEL}", new_{namespace}_{model}_path, class: "btn-primary btn-sm" %>
    </div>
  </div>

  <div class="card-body p-0">
    <% if @{models}.any? %>
      <%%= render "{namespace}/{models}/table", {models}: @{models} %>
    <% else %>
      <div class="empty-state">
        <p class="text-muted">No {models} found.</p>
        <%%= link_to "Create the first {model}", new_{namespace}_{model}_path, class: "btn-primary" %>
      </div>
    <% end %>
  </div>

  <%# Pagination %>
  <div class="card-footer flex-between">
    <div class="pagination-info">
      <%%= pagy_info(@pagy) %>
    </div>
    <div class="pagination-nav">
      <%%== pagy_nav(@pagy) %>
    </div>
  </div>
</div>

<%# JavaScript for bulk selection (non-Stimulus fallback) %>
<% unless defined?(Stimulus) %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const selectAll = document.getElementById('select-all');
  const checkboxes = document.querySelectorAll('.row-checkbox');
  const bulkBar = document.getElementById('bulk-actions-bar');
  const countSpan = document.getElementById('selected-count');
  const deleteBtn = document.getElementById('bulk-delete-btn');

  function updateUI() {
    const checked = Array.from(checkboxes).filter(cb => cb.checked);
    const count = checked.length;

    bulkBar.classList.toggle('hidden', count === 0);
    countSpan.textContent = count;

    // Update hidden field with selected IDs
    const ids = checked.map(cb => cb.value);
    deleteBtn.closest('form').querySelector('input[name="ids[]"]')?.remove();
    ids.forEach(id => {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'ids[]';
      input.value = id;
      deleteBtn.closest('form').appendChild(input);
    });
  }

  selectAll?.addEventListener('change', function() {
    checkboxes.forEach(cb => cb.checked = this.checked);
    updateUI();
  });

  checkboxes.forEach(cb => {
    cb.addEventListener('change', updateUI);
  });
});
</script>
<% end %>
