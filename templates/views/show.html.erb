<%# Template: Show View for Resource Details
#
# Variables to replace:
#   {namespace} - Lowercase namespace (e.g., admin)
#   {MODEL} - Model class name (e.g., User)
#   {model} - Lowercase singular (e.g., user)
#   {models} - Lowercase plural (e.g., users)
#   {MODEL_TITLE} - Human readable singular (e.g., "User")
#   {DISPLAY_FIELDS} - Array of fields to display with types
#   {ASSOCIATIONS} - Array of associations to show
#   {HAS_SOFT_DELETE} - true/false
#
# CSS classes use {CSS_FRAMEWORK} placeholders.
%>

<div class="{CSS: page-header}">
  <div class="{CSS: header-content}">
    <div class="{CSS: breadcrumb}">
      <%%= link_to "{MODEL_TITLE}s", {namespace}_{models}_path, class: "{CSS: breadcrumb-link}" %>
      <span class="{CSS: breadcrumb-separator}">/</span>
      <span class="{CSS: breadcrumb-current}"><%%= @{model}.to_s %></span>
    </div>
    <h1 class="{CSS: page-title}">{MODEL_TITLE} Details</h1>
  </div>
  <div class="{CSS: header-actions}">
    <%%= link_to "Edit", edit_{namespace}_{model}_path(@{model}), class: "{CSS: btn-primary}" %>
    <%%= link_to "Back to List", {namespace}_{models}_path, class: "{CSS: btn-outline}" %>
  </div>
</div>

<%# Soft Delete Warning Banner %>
<% if {HAS_SOFT_DELETE} && @{model}.respond_to?(:discarded?) && @{model}.discarded? %>
  <div class="{CSS: alert-warning} {CSS: mb-4}">
    <strong>This record has been deleted.</strong>
    Deleted at: <%%= @{model}.discarded_at&.strftime("%Y-%m-%d %H:%M") %>
    <%%= button_to "Restore",
                  restore_{namespace}_{model}_path(@{model}),
                  method: :patch,
                  class: "{CSS: btn-warning} {CSS: btn-sm} {CSS: ml-4}" %>
  </div>
<% end %>

<div class="{CSS: grid-2}">
  <%# Main Details Card %>
  <div class="{CSS: card}">
    <div class="{CSS: card-header}">
      <h2 class="{CSS: card-title}">Details</h2>
    </div>
    <div class="{CSS: card-body}">
      <dl class="{CSS: description-list}">
        <%# ID %>
        <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">ID</dt>
          <dd class="{CSS: dl-detail}"><%%= @{model}.id %></dd>
        </div>

        <%#
        # FIELD DISPLAY PATTERNS:
        # Replace this section with actual fields based on model schema.
        # See reference/field-mappings.md for display patterns.
        %>

        <%# String Field %>
        <%# <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Name</dt>
          <dd class="{CSS: dl-detail}"><%%= @{model}.name %></dd>
        </div> %>

        <%# Text Field (potentially long) %>
        <%# <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Description</dt>
          <dd class="{CSS: dl-detail}"><%%= simple_format(@{model}.description) %></dd>
        </div> %>

        <%# Boolean Field %>
        <%# <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Active</dt>
          <dd class="{CSS: dl-detail}">
            <span class="{CSS: badge} <%%= @{model}.active? ? '{CSS: badge-success}' : '{CSS: badge-secondary}' %>">
              <%%= @{model}.active? ? 'Yes' : 'No' %>
            </span>
          </dd>
        </div> %>

        <%# Enum Field %>
        <%# <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Status</dt>
          <dd class="{CSS: dl-detail}">
            <span class="{CSS: badge} {CSS: badge-status-<%%= @{model}.status %>}">
              <%%= @{model}.status.humanize %>
            </span>
          </dd>
        </div> %>

        <%# Belongs To Association %>
        <%# <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Author</dt>
          <dd class="{CSS: dl-detail}">
            <% if @{model}.author %>
              <%%= link_to @{model}.author.name, {namespace}_user_path(@{model}.author), class: "{CSS: link}" %>
            <% else %>
              <span class="{CSS: text-muted}">None</span>
            <% end %>
          </dd>
        </div> %>

        <%# JSON/JSONB Field %>
        <%# <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Metadata</dt>
          <dd class="{CSS: dl-detail}">
            <% if @{model}.metadata.present? %>
              <pre class="{CSS: code-block}"><%%= JSON.pretty_generate(@{model}.metadata) %></pre>
            <% else %>
              <span class="{CSS: text-muted}">Empty</span>
            <% end %>
          </dd>
        </div> %>

        <%# Active Storage Single Attachment %>
        <%# <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Avatar</dt>
          <dd class="{CSS: dl-detail}">
            <% if @{model}.avatar.attached? %>
              <% if @{model}.avatar.image? %>
                <%%= image_tag @{model}.avatar.variant(resize_to_limit: [200, 200]), class: "{CSS: img-thumbnail}" %>
              <% else %>
                <%%= link_to @{model}.avatar.filename, rails_blob_path(@{model}.avatar, disposition: "attachment"), class: "{CSS: link}" %>
              <% end %>
            <% else %>
              <span class="{CSS: text-muted}">No file attached</span>
            <% end %>
          </dd>
        </div> %>

        <%# Active Storage Multiple Attachments %>
        <%# <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Images</dt>
          <dd class="{CSS: dl-detail}">
            <% if @{model}.images.attached? %>
              <div class="{CSS: image-grid}">
                <% @{model}.images.each do |image| %>
                  <% if image.image? %>
                    <%%= image_tag image.variant(resize_to_limit: [150, 150]), class: "{CSS: img-thumbnail}" %>
                  <% else %>
                    <%%= link_to image.filename, rails_blob_path(image, disposition: "attachment"), class: "{CSS: link}" %>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <span class="{CSS: text-muted}">No files attached</span>
            <% end %>
          </dd>
        </div> %>

        <%# Timestamps %>
        <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Created At</dt>
          <dd class="{CSS: dl-detail}"><%%= @{model}.created_at&.strftime("%Y-%m-%d %H:%M:%S") %></dd>
        </div>
        <div class="{CSS: dl-row}">
          <dt class="{CSS: dl-term}">Updated At</dt>
          <dd class="{CSS: dl-detail}"><%%= @{model}.updated_at&.strftime("%Y-%m-%d %H:%M:%S") %></dd>
        </div>
      </dl>
    </div>
  </div>

  <%# Associations Panel %>
  <div class="{CSS: card}">
    <div class="{CSS: card-header}">
      <h2 class="{CSS: card-title}">Related Records</h2>
    </div>
    <div class="{CSS: card-body}">
      <%#
      # HAS MANY ASSOCIATIONS:
      # Replace with actual associations from model analysis.
      %>

      <%# Example: has_many :comments %>
      <%# <div class="{CSS: association-section}">
        <h3 class="{CSS: section-title}">Comments (<%%= @{model}.comments.count %>)</h3>
        <% if @{model}.comments.any? %>
          <ul class="{CSS: list}">
            <% @{model}.comments.limit(5).each do |comment| %>
              <li class="{CSS: list-item}">
                <%%= link_to comment.to_s, {namespace}_comment_path(comment), class: "{CSS: link}" %>
                <span class="{CSS: text-muted} {CSS: text-sm}">
                  <%%= comment.created_at.strftime("%Y-%m-%d") %>
                </span>
              </li>
            <% end %>
          </ul>
          <% if @{model}.comments.count > 5 %>
            <%%= link_to "View all comments", {namespace}_comments_path(q: { {model}_id_eq: @{model}.id }), class: "{CSS: link}" %>
          <% end %>
        <% else %>
          <p class="{CSS: text-muted}">No comments yet.</p>
        <% end %>
      </div> %>

      <p class="{CSS: text-muted}">No related records configured.</p>
    </div>
  </div>
</div>

<%# Action Buttons %>
<div class="{CSS: action-bar} {CSS: mt-4}">
  <%%= link_to "Edit", edit_{namespace}_{model}_path(@{model}), class: "{CSS: btn-primary}" %>

  <% if {HAS_SOFT_DELETE} && @{model}.respond_to?(:discarded?) && @{model}.discarded? %>
    <%%= button_to "Restore",
                  restore_{namespace}_{model}_path(@{model}),
                  method: :patch,
                  class: "{CSS: btn-success}" %>
    <%%= button_to "Permanently Delete",
                  {namespace}_{model}_path(@{model}),
                  method: :delete,
                  class: "{CSS: btn-danger}",
                  data: { turbo_confirm: "This will permanently delete the record. Are you sure?" } %>
  <% else %>
    <%%= button_to "Delete",
                  {namespace}_{model}_path(@{model}),
                  method: :delete,
                  class: "{CSS: btn-danger}",
                  data: { turbo_confirm: "Are you sure you want to delete this {model}?" } %>
  <% end %>

  <%%= link_to "Back to List", {namespace}_{models}_path, class: "{CSS: btn-outline}" %>
</div>
