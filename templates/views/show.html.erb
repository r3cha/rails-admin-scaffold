<%# Template: Show View for Resource Details
#
# Variables to replace:
#   {namespace} - Lowercase namespace (e.g., admin)
#   {MODEL} - Model class name (e.g., User)
#   {model} - Lowercase singular (e.g., user)
#   {models} - Lowercase plural (e.g., users)
#   {MODEL_TITLE} - Human readable singular (e.g., "User")
#   {DISPLAY_FIELDS} - Array of fields to display with types
#   {ASSOCIATIONS} - Array of associations to show
#   {HAS_SOFT_DELETE} - true/false
#
# Replace all CSS classes below with appropriate classes for the detected framework.
# Class names shown are semantic hints only.
%>

<div class="page-header">
  <div class="header-content">
    <div class="breadcrumb">
      <%%= link_to "{MODEL_TITLE}s", {namespace}_{models}_path, class: "breadcrumb-link" %>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current"><%%= @{model}.to_s %></span>
    </div>
    <h1 class="page-title">{MODEL_TITLE} Details</h1>
  </div>
  <div class="header-actions">
    <%%= link_to "Edit", edit_{namespace}_{model}_path(@{model}), class: "btn-primary" %>
    <%%= link_to "Back to List", {namespace}_{models}_path, class: "btn-outline" %>
  </div>
</div>

<%# Soft Delete Warning Banner %>
<% if {HAS_SOFT_DELETE} && @{model}.respond_to?(:discarded?) && @{model}.discarded? %>
  <div class="alert-warning mb-4">
    <strong>This record has been deleted.</strong>
    Deleted at: <%%= @{model}.discarded_at&.strftime("%Y-%m-%d %H:%M") %>
    <%%= button_to "Restore",
                  restore_{namespace}_{model}_path(@{model}),
                  method: :patch,
                  class: "btn-warning btn-sm ml-4" %>
  </div>
<% end %>

<div class="grid-2">
  <%# Main Details Card %>
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Details</h2>
    </div>
    <div class="card-body">
      <dl class="description-list">
        <%# ID %>
        <div class="dl-row">
          <dt class="dl-term">ID</dt>
          <dd class="dl-detail"><%%= @{model}.id %></dd>
        </div>

        <%#
        # FIELD DISPLAY PATTERNS:
        # Replace this section with actual fields based on model schema.
        # See reference/field-mappings.md for display patterns.
        %>

        <%# String Field %>
        <%# <div class="dl-row">
          <dt class="dl-term">Name</dt>
          <dd class="dl-detail"><%%= @{model}.name %></dd>
        </div> %>

        <%# Text Field (potentially long) %>
        <%# <div class="dl-row">
          <dt class="dl-term">Description</dt>
          <dd class="dl-detail"><%%= simple_format(@{model}.description) %></dd>
        </div> %>

        <%# Boolean Field %>
        <%# <div class="dl-row">
          <dt class="dl-term">Active</dt>
          <dd class="dl-detail">
            <span class="badge <%%= @{model}.active? ? 'badge-success' : 'badge-secondary' %>">
              <%%= @{model}.active? ? 'Yes' : 'No' %>
            </span>
          </dd>
        </div> %>

        <%# Enum Field %>
        <%# <div class="dl-row">
          <dt class="dl-term">Status</dt>
          <dd class="dl-detail">
            <span class="badge badge-status-<%%= @{model}.status %>">
              <%%= @{model}.status.humanize %>
            </span>
          </dd>
        </div> %>

        <%# Belongs To Association %>
        <%# <div class="dl-row">
          <dt class="dl-term">Author</dt>
          <dd class="dl-detail">
            <% if @{model}.author %>
              <%%= link_to @{model}.author.name, {namespace}_user_path(@{model}.author), class: "link" %>
            <% else %>
              <span class="text-muted">None</span>
            <% end %>
          </dd>
        </div> %>

        <%# JSON/JSONB Field %>
        <%# <div class="dl-row">
          <dt class="dl-term">Metadata</dt>
          <dd class="dl-detail">
            <% if @{model}.metadata.present? %>
              <pre class="code-block"><%%= JSON.pretty_generate(@{model}.metadata) %></pre>
            <% else %>
              <span class="text-muted">Empty</span>
            <% end %>
          </dd>
        </div> %>

        <%# Active Storage Single Attachment %>
        <%# <div class="dl-row">
          <dt class="dl-term">Avatar</dt>
          <dd class="dl-detail">
            <% if @{model}.avatar.attached? %>
              <% if @{model}.avatar.image? %>
                <%%= image_tag @{model}.avatar.variant(resize_to_limit: [200, 200]), class: "img-thumbnail" %>
              <% else %>
                <%%= link_to @{model}.avatar.filename, rails_blob_path(@{model}.avatar, disposition: "attachment"), class: "link" %>
              <% end %>
            <% else %>
              <span class="text-muted">No file attached</span>
            <% end %>
          </dd>
        </div> %>

        <%# Active Storage Multiple Attachments %>
        <%# <div class="dl-row">
          <dt class="dl-term">Images</dt>
          <dd class="dl-detail">
            <% if @{model}.images.attached? %>
              <div class="image-grid">
                <% @{model}.images.each do |image| %>
                  <% if image.image? %>
                    <%%= image_tag image.variant(resize_to_limit: [150, 150]), class: "img-thumbnail" %>
                  <% else %>
                    <%%= link_to image.filename, rails_blob_path(image, disposition: "attachment"), class: "link" %>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <span class="text-muted">No files attached</span>
            <% end %>
          </dd>
        </div> %>

        <%# Timestamps %>
        <div class="dl-row">
          <dt class="dl-term">Created At</dt>
          <dd class="dl-detail"><%%= @{model}.created_at&.strftime("%Y-%m-%d %H:%M:%S") %></dd>
        </div>
        <div class="dl-row">
          <dt class="dl-term">Updated At</dt>
          <dd class="dl-detail"><%%= @{model}.updated_at&.strftime("%Y-%m-%d %H:%M:%S") %></dd>
        </div>
      </dl>
    </div>
  </div>

  <%# Associations Panel %>
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Related Records</h2>
    </div>
    <div class="card-body">
      <%#
      # HAS MANY ASSOCIATIONS:
      # Replace with actual associations from model analysis.
      %>

      <%# Example: has_many :comments %>
      <%# <div class="association-section">
        <h3 class="section-title">Comments (<%%= @{model}.comments.count %>)</h3>
        <% if @{model}.comments.any? %>
          <ul class="list">
            <% @{model}.comments.limit(5).each do |comment| %>
              <li class="list-item">
                <%%= link_to comment.to_s, {namespace}_comment_path(comment), class: "link" %>
                <span class="text-muted text-sm">
                  <%%= comment.created_at.strftime("%Y-%m-%d") %>
                </span>
              </li>
            <% end %>
          </ul>
          <% if @{model}.comments.count > 5 %>
            <%%= link_to "View all comments", {namespace}_comments_path(q: { {model}_id_eq: @{model}.id }), class: "link" %>
          <% end %>
        <% else %>
          <p class="text-muted">No comments yet.</p>
        <% end %>
      </div> %>

      <p class="text-muted">No related records configured.</p>
    </div>
  </div>
</div>

<%# Action Buttons %>
<div class="action-bar mt-4">
  <%%= link_to "Edit", edit_{namespace}_{model}_path(@{model}), class: "btn-primary" %>

  <% if {HAS_SOFT_DELETE} && @{model}.respond_to?(:discarded?) && @{model}.discarded? %>
    <%%= button_to "Restore",
                  restore_{namespace}_{model}_path(@{model}),
                  method: :patch,
                  class: "btn-success" %>
    <%%= button_to "Permanently Delete",
                  {namespace}_{model}_path(@{model}),
                  method: :delete,
                  class: "btn-danger",
                  data: { turbo_confirm: "This will permanently delete the record. Are you sure?" } %>
  <% else %>
    <%%= button_to "Delete",
                  {namespace}_{model}_path(@{model}),
                  method: :delete,
                  class: "btn-danger",
                  data: { turbo_confirm: "Are you sure you want to delete this {model}?" } %>
  <% end %>

  <%%= link_to "Back to List", {namespace}_{models}_path, class: "btn-outline" %>
</div>
