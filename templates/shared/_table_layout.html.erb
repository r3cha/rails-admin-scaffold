<%# Template: Table Layout Wrapper
#
# This partial wraps table content with consistent styling.
# Use as: render layout: "{namespace}/shared/table_layout" do ... end
#
# Replace all CSS classes below with appropriate classes for the detected framework.
# Class names shown are semantic hints only.
%>

<div class="table-container">
  <%# Table Toolbar (filters, search, bulk actions) %>
  <%% if content_for?(:table_toolbar) %>
    <div class="table-toolbar">
      <%%= yield :table_toolbar %>
    </div>
  <%% end %>

  <%# Main Table Content %>
  <div class="table-wrapper">
    <%%= yield %>
  </div>

  <%# Table Footer (pagination, export buttons) %>
  <%% if content_for?(:table_footer) %>
    <div class="table-footer">
      <%%= yield :table_footer %>
    </div>
  <%% end %>
</div>
