<%# Template: Flash Messages
#
# Replace all CSS classes below with appropriate classes for the detected framework.
# Class names shown are semantic hints only.
%>

<%% flash.each do |type, message| %>
  <%% next if message.blank? %>

  <%%
    # Map Rails flash types to CSS alert classes
    # Replace these class names with appropriate ones for the detected framework
    alert_class = case type.to_sym
                  when :notice, :success
                    "alert-success"
                  when :alert, :error
                    "alert-danger"
                  when :warning
                    "alert-warning"
                  else
                    "alert-info"
                  end
  %>

  <div class="alert <%%= alert_class %> alert-dismissible"
       role="alert"
       data-controller="alert"
       data-alert-auto-dismiss-value="5000">

    <div class="alert-content">
      <%# Icon based on type %>
      <%%
        icon_path = case type.to_sym
                    when :notice, :success
                      "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    when :alert, :error
                      "M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    when :warning
                      "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                    else
                      "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    end
      %>

      <svg class="alert-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%%= icon_path %>"/>
      </svg>

      <span class="alert-message"><%%= message %></span>
    </div>

    <%# Dismiss Button %>
    <button type="button"
            class="alert-dismiss"
            data-action="alert#dismiss"
            aria-label="Dismiss">
      <svg class="icon-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>
<%% end %>

<%# Non-Stimulus fallback for auto-dismiss %>
<% unless defined?(Stimulus) %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-controller="alert"]').forEach(function(alert) {
      const timeout = parseInt(alert.dataset.alertAutoDismissValue) || 5000;

      // Auto dismiss after timeout
      setTimeout(function() {
        alert.style.opacity = '0';
        alert.style.transition = 'opacity 0.3s ease';
        setTimeout(function() { alert.remove(); }, 300);
      }, timeout);

      // Manual dismiss
      alert.querySelector('[data-action="alert#dismiss"]')?.addEventListener('click', function() {
        alert.remove();
      });
    });
  });
</script>
<% end %>
