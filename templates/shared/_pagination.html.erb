<%# Template: Pagination Controls
#
# Variables to replace:
#   {PAGINATION_GEM} - pagy, kaminari, or will_paginate
#
# Replace all CSS classes below with appropriate classes for the detected framework.
# Class names shown are semantic hints only.
%>

<%#
# PAGY PAGINATION (default)
# Requires pagy gem and Pagy::Backend include in controller
%>

<%# For Pagy: %>
<%%== pagy_nav(@pagy) if @pagy %>

<%# For Pagy with info: %>
<%# <div class="pagination-container">
  <div class="pagination-info">
    <%%= pagy_info(@pagy) %>
  </div>
  <div class="pagination-nav">
    <%%== pagy_nav(@pagy) %>
  </div>
</div> %>

<%#
# KAMINARI PAGINATION
# Uncomment if using Kaminari
%>

<%# For Kaminari:
<div class="pagination-container">
  <div class="pagination-info">
    Showing <%%= @{models}.offset_value + 1 %> to
    <%%= [@{models}.offset_value + @{models}.limit_value, @{models}.total_count].min %> of
    <%%= @{models}.total_count %> entries
  </div>
  <div class="pagination-nav">
    <%%= paginate @{models} %>
  </div>
</div>
%>

<%#
# WILL_PAGINATE PAGINATION
# Uncomment if using will_paginate
%>

<%# For will_paginate:
<div class="pagination-container">
  <div class="pagination-info">
    <%%= page_entries_info @{models} %>
  </div>
  <div class="pagination-nav">
    <%%= will_paginate @{models} %>
  </div>
</div>
%>

<%#
# Custom Pagy styling for Tailwind
# Add this to your pagy.rb initializer for Tailwind styling:
#
# Pagy::DEFAULT[:size] = [1, 2, 2, 1]
#
# Or create a custom nav helper for more control.
%>
