<%# Template: Filter Bar (collapsible filters)
#
# Variables to replace:
#   {namespace} - Lowercase namespace (e.g., admin)
#   {models} - Lowercase plural (e.g., users)
#
# CSS classes use {CSS_FRAMEWORK} placeholders.
%>

<div class="{CSS: filter-bar}"
     data-controller="collapse"
     data-collapse-open-value="false">

  <%# Filter Toggle Button %>
  <div class="{CSS: filter-bar-header}">
    <button type="button"
            class="{CSS: filter-toggle}"
            data-action="collapse#toggle">
      <svg class="{CSS: icon}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
      </svg>
      <span>Filters</span>
      <span class="{CSS: filter-count}" data-collapse-target="badge">
        <%# Show count of active filters %>
        <%% active_filters = params[:q]&.values&.reject(&:blank?)&.count || 0 %>
        <%% if active_filters > 0 %>
          (<%%= active_filters %>)
        <%% end %>
      </span>
      <svg class="{CSS: chevron-icon}" data-collapse-target="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </button>

    <%# Quick Actions %>
    <div class="{CSS: filter-bar-actions}">
      <%% if params[:q].present? %>
        <%%= link_to "Clear All", {namespace}_{models}_path, class: "{CSS: btn-ghost} {CSS: btn-sm}" %>
      <%% end %>
    </div>
  </div>

  <%# Collapsible Filter Content %>
  <div class="{CSS: filter-content}" data-collapse-target="content">
    <%%= yield %>
  </div>
</div>

<%# Non-Stimulus fallback for collapse %>
<% unless defined?(Stimulus) %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('[data-controller="collapse"]').forEach(function(el) {
      const toggle = el.querySelector('[data-action="collapse#toggle"]');
      const content = el.querySelector('[data-collapse-target="content"]');
      const icon = el.querySelector('[data-collapse-target="icon"]');

      // Check if filters are active, auto-expand
      const hasActiveFilters = <%%= params[:q].present? ? 'true' : 'false' %>;
      if (hasActiveFilters) {
        content.style.display = 'block';
        icon?.classList.add('rotate-180');
      }

      toggle?.addEventListener('click', function() {
        const isOpen = content.style.display !== 'none';
        content.style.display = isOpen ? 'none' : 'block';
        icon?.classList.toggle('rotate-180', !isOpen);
      });
    });
  });
</script>
<% end %>
